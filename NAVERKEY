VerifyButton.Activated:Connect(function()
    if IsVerifying or IsClosing then
        return
    end

    IsVerifying = true
    VerifyButton.Active = false
    VerifyButton.Text = "CHECKING ACCESS..."

    Status.Text = "VALIDATING LICENSE..."
    Status.TextColor3 = T.Primary
    StatusDot.BackgroundColor3 = T.Primary

    Tween(KeyCardStroke, 0.2, {
        Color = T.Primary,
        Transparency = 0,
    })

    task.wait(0.35)

    if IsKeyValid(KeyBox.Text) then
        Status.Text = "ACCESS GRANTED ✓"
        Status.TextColor3 = T.Success
        StatusDot.BackgroundColor3 = T.Success

        VerifyButton.Text = "ACCESS GRANTED"
        VerifyButton.BackgroundColor3 = T.Success

        Tween(KeyCardStroke, 0.2, {
            Color = T.Success,
            Transparency = 0,
        })

        task.wait(0.65)

        CloseGUI()
        RunMainScript()
    else
        Status.Text = "INVALID KEY — TRY AGAIN"
        Status.TextColor3 = T.Error
        StatusDot.BackgroundColor3 = T.Error

        VerifyButton.Text = "INVALID KEY"
        VerifyButton.BackgroundColor3 = T.Error

        Tween(KeyCardStroke, 0.12, {
            Color = T.Error,
            Transparency = 0,
        })

        -- Small shake effect.
        local originalPosition = Main.Position

        for _, offset in ipairs({-7, 7, -5, 5, 0}) do
            if not Main.Parent then
                break
            end

            Tween(Main, 0.035, {
                Position = originalPosition + UDim2.fromOffset(offset, 0),
            }, Enum.EasingStyle.Linear)

            task.wait(0.035)
        end

        if Main.Parent then
            Main.Position = originalPosition
        end

        task.wait(0.6)

        if ScreenGui.Parent and not IsClosing then
            VerifyButton.Text = "VERIFY ACCESS     →"
            VerifyButton.BackgroundColor3 = T.Primary
            VerifyButton.Active = true

            Status.Text = "READY FOR VERIFICATION"
            Status.TextColor3 = T.Text
            StatusDot.BackgroundColor3 = T.Success

            Tween(KeyCardStroke, 0.2, {
                Color = T.Border,
                Transparency = 0.25,
            })
        end

        IsVerifying = false
    end
end)

