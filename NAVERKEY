local function CopyText(text)
    -- Clipboard access is not available in normal Roblox Studio LocalScripts.
    -- If this environment provides setclipboard, use it.
    if type(setclipboard) == "function" then
        local success = pcall(setclipboard, text)
        if success then
            return true
        end
    end

    -- Fallback: put the URL in the key input so it can be selected manually.
    KeyBox.Text = text
    KeyBox:CaptureFocus()
    KeyBox.CursorPosition = #text + 1

    return false
end

