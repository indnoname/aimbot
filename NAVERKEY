local IsClosing = false
local IsVerifying = false

local function OpenAnimation()
    Tween(Overlay, Anim.OpenTime, {
        BackgroundTransparency = 0.32,
    })

    Tween(Main, Anim.OpenTime, {
        BackgroundTransparency = 0,
        Size = UDim2.fromOffset(width, height),
    }, Enum.EasingStyle.Back)

    Tween(Scale, Anim.OpenTime, {
        Scale = 1,
    }, Enum.EasingStyle.Back)

    Tween(MainStroke, Anim.OpenTime, {
        Transparency = 0.1,
    })

    if BlurEffect then
        Tween(BlurEffect, Anim.OpenTime, {
            Size = Anim.BlurSize,
        })
    end

    -- Scan the accent light across the top.
    if Anim.EnableScanLine then
        task.spawn(function()
            while ScreenGui.Parent and not IsClosing do
                GlowLine.Position = UDim2.new(-0.4, 0, 0, 3)

                local scan = Tween(GlowLine, 1.1, {
                    Position = UDim2.new(1.05, 0, 0, 3),
                }, Enum.EasingStyle.Linear)

                scan.Completed:Wait()
                task.wait(1.0)
            end
        end)
    end

    -- Gentle breathing glow on the border.
    task.spawn(function()
        while ScreenGui.Parent and not IsClosing do
            Tween(MainStroke, 0.9, {
                Transparency = 0.35,
            })
            task.wait(0.9)

            if not ScreenGui.Parent or IsClosing then
                break
            end

            Tween(MainStroke, 0.9, {
                Transparency = 0.08,
            })
            task.wait(0.9)
        end
    end)
end

local function CloseGUI()
    if IsClosing then
        return
    end

    IsClosing = true

    Tween(Overlay, Anim.CloseTime, {
        BackgroundTransparency = 1,
    })

    Tween(Main, Anim.CloseTime, {
        BackgroundTransparency = 1,
        Size = UDim2.fromOffset(width * 0.9, height * 0.9),
    }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)

    Tween(Scale, Anim.CloseTime, {
        Scale = 0.88,
    }, Enum.EasingStyle.Quint, Enum.EasingDirection.In)

    Tween(MainStroke, Anim.CloseTime, {
        Transparency = 1,
    })

    if BlurEffect then
        Tween(BlurEffect, Anim.CloseTime, {
            Size = 0,
        })
    end

    task.wait(Anim.CloseTime + 0.05)

    if BlurEffect then
        BlurEffect:Destroy()
    end

    ScreenGui:Destroy()
end

