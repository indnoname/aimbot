local Busy = false
local function VerifyKey()
    if Busy then 
        local Verifykey = false 
        return
    end
    if Box.Text ~= VALID_KEY then
        Status.Text = "Invalid key!"
        Status.TextColor3 = Color3.fromRGB(255, 75, 75)
        return
    end

    Busy = true

    if not SaveKey() then
        Busy = false
        Status.Text = "Unable to save key"
        Status.TextColor3 = Color3.fromRGB(255, 75, 75)
        return
    end

    Status.Text = "Key accepted!"
    Status.TextColor3 = Color3.fromRGB(90, 230, 130)

    task.wait(0.3)
    ScreenGui:Destroy()
    RunMainScript()
end

Verify.Activated:Connect(VerifyKey)

Box.FocusLost:Connect(function(enterPressed)
