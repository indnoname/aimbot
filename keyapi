
local VALID_KEY = "PVkeyVLN-2957140-RTCLI-Client"
local SAVE_FILE = "client.txt"

local Players = game:GetService("Players")  
local CoreGui = game:GetService("CoreGui")
local VerifyKey = nil
local function HasSavedKey()
    if type(isfile) ~= "function"
        or type(readfile) ~= "function" then
        return false
    end

    local ok, result = pcall(function()
        return isfile(SAVE_FILE)
            and readfile(SAVE_FILE) == VALID_KEY
    end)

    return ok and result == true
end

local function SaveKey()
    if type(writefile) ~= "function" then
        return false
    end

    local ok = pcall(function()
        writefile(SAVE_FILE, VALID_KEY)
    end)

    return ok
end

local function RunMainScript()
   loadstring(game:HttpGet("https://raw.githubusercontent.com/indnoname/aimbot/refs/heads/main/aimbot"))() 
   return
end

