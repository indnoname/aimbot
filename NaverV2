
--==================================================
-- Q SLASH SYSTEM | LocalScript
--==================================================

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local Player = Players.LocalPlayer

-- CONFIG
local MAX_DISTANCE = 6.5
local COOLDOWN = 0.5
local KEYBIND = Enum.KeyCode.Q

-- STATE
local Character
local Humanoid
local Animator
local AnimationTrack

local Tool
local DamageEvent
local Animation
local HitBox
local HitSound

local Equipped = false
local Busy = false
local AttackActive = false
local AttackHit = false
local LastAttack = 0

local HitConnection
local BoundTools = {}
local CharacterChildConnection

--==================================================
-- ตั้งค่า Tool
--==================================================

local function SetupTool(CurrentTool)
    if not CurrentTool or not CurrentTool:IsA("Tool") then
        return false
    end

    local Handle = CurrentTool:FindFirstChild("Handle")
    if not Handle then
        warn("Q Slash: ไม่พบ Handle")
        return false
    end

    local CurrentHitBox = Handle:FindFirstChild("HitBox")
    local CurrentHitSound = Handle:FindFirstChild("Hit")

    if not CurrentHitBox or not CurrentHitBox:IsA("BasePart") then
        warn("Q Slash: ไม่พบ Handle.HitBox")
        return false
    end

    if not CurrentHitSound or not CurrentHitSound:IsA("Sound") then
        warn("Q Slash: ไม่พบ Handle.Hit")
        return false
    end

    -- หา RemoteEvent
    local CurrentEvent = CurrentTool:FindFirstChild("Damage", true)

    if not CurrentEvent then
        local LocalScriptObject =
            CurrentTool:FindFirstChild("LocalScript")

        CurrentEvent = LocalScriptObject
            and LocalScriptObject:FindFirstChild("Damage")
    end

    if not CurrentEvent or not CurrentEvent:IsA("RemoteEvent") then
        warn("Q Slash: ไม่พบ RemoteEvent Damage")
        return false
    end

    -- หา Animation
    local CurrentAnimation =
        CurrentTool:FindFirstChild("RightSlashx", true)

    if not CurrentAnimation
        or not CurrentAnimation:IsA("Animation") then
        warn("Q Slash: ไม่พบ Animation RightSlashx")
        return false
    end

    Tool = CurrentTool
    DamageEvent = CurrentEvent
    Animation = CurrentAnimation
    HitBox = CurrentHitBox
    HitSound = CurrentHitSound

    return true
end

--==================================================
-- โหลด Animation
--==================================================

local function LoadAnimation()
    if not Character or not Humanoid or Humanoid.Health <= 0 then
        return false
    end

    if not SetupTool(Tool) then
        return false
    end

    Animator = Humanoid:FindFirstChildOfClass("Animator")

    if not Animator then
        Animator = Instance.new("Animator")
        Animator.Parent = Humanoid
    end

    if AnimationTrack then
        AnimationTrack:Stop()
        AnimationTrack:Destroy()
        AnimationTrack = nil
    end

    local Success, Result = pcall(function()
        return Animator:LoadAnimation(Animation)
    end)

    if not Success then
        warn("Q Slash: โหลด Animation ไม่สำเร็จ:", Result)
        return false
    end

    AnimationTrack = Result
    return true
end

--==================================================
-- หาผู้เล่นที่ HitBox สัมผัสจริง
--==================================================

local function GetTouchedPlayer(Part)
    if not Part or not Part:IsA("BasePart") then
        return nil, nil, nil
    end

    if not Character or Part:IsDescendantOf(Character) then
        return nil, nil, nil
    end

    if Tool and Part:IsDescendantOf(Tool) then
        return nil, nil, nil
    end

    -- รองรับ Part ที่อยู่ใน Accessory ของตัวละคร
    local Current = Part
    local TargetPlayer
    local TargetModel

    while Current and Current ~= workspace do
        if Current:IsA("Model") then
            local FoundPlayer = Players:GetPlayerFromCharacter(Current)

            if FoundPlayer then
                TargetPlayer = FoundPlayer
                TargetModel = Current
                break
            end
        end

        Current = Current.Parent
    end

    if not TargetPlayer or not TargetModel then
        return nil, nil, nil
    end

    if TargetPlayer == Player then
        return nil, nil, nil
    end

    local TargetHumanoid =
        TargetModel:FindFirstChildOfClass("Humanoid")

    local TargetRoot =
        TargetModel:FindFirstChild("HumanoidRootPart")

    local MyRoot =
        Character:FindFirstChild("HumanoidRootPart")

    -- ต้องยังมีชีวิตอยู่
    if not TargetHumanoid
        or TargetHumanoid.Health <= 0
        or not TargetRoot
        or not MyRoot then
        return nil, nil, nil
    end

    local Distance =
        (MyRoot.Position - TargetRoot.Position).Magnitude

    if Distance > MAX_DISTANCE then
        return nil, nil, nil
    end

    return TargetPlayer, TargetModel, TargetHumanoid
end

--==================================================
-- หยุดตรวจจับ HitBox
--==================================================

local function StopHitDetection()
    AttackActive = false

    if HitConnection then
        HitConnection:Disconnect()
        HitConnection = nil
    end
end

--==================================================
-- เริ่มตรวจจับ HitBox
--==================================================

local function StartHitDetection()
    StopHitDetection()

    if not HitBox or not HitBox:IsA("BasePart") then
        return
    end

    if not HitBox.CanTouch then
        warn("Q Slash: กรุณาเปิด HitBox.CanTouch")
        return
    end

    AttackActive = true
    AttackHit = false

    HitConnection = HitBox.Touched:Connect(function(Part)
        if not AttackActive or AttackHit then
            return
        end

        local TargetPlayer, TargetModel, TargetHumanoid =
            GetTouchedPlayer(Part)

        if not TargetPlayer or not TargetModel or not TargetHumanoid then
            return
        end

        -- ตรวจเลือดซ้ำก่อนเลือกเป้าหมาย
        if TargetHumanoid.Health <= 0 then
            return
        end

        -- เลือกคนแรกที่ HitBox สัมผัสในรอบนี้
        AttackHit = true
        AttackActive = false

        if HitConnection then
            HitConnection:Disconnect()
            HitConnection = nil
        end

        -- เล่นเสียงเมื่อสัมผัสเป้าหมาย
        if HitSound then
            HitSound:Stop()
            HitSound.TimePosition = 0
            HitSound:Play()
        end

        -- ตรวจสอบเป้าหมายอีกครั้ง
        if TargetPlayer.Parent ~= Players
            or not TargetModel.Parent
            or TargetHumanoid.Health <= 0 then
            return
        end

        if not DamageEvent
            or not DamageEvent:IsA("RemoteEvent") then
            warn("Q Slash: DamageEvent ไม่พร้อมใช้งาน")
            return
        end

        DamageEvent:FireServer(TargetModel, "Head")
    end)
end

--==================================================
-- จบการโจมตี
--==================================================

local function FinishAttack()
    StopHitDetection()
    Busy = false
end

--==================================================
-- กด Q เพื่อโจมตี
--==================================================

UserInputService.InputBegan:Connect(function(Input, Processed)
    if Processed then
        return
    end

    if Input.KeyCode ~= KEYBIND then
        return
    end

    if not Equipped or Busy then
        return
    end

    if os.clock() - LastAttack < COOLDOWN then
        return
    end

    if not Character or not Humanoid or Humanoid.Health <= 0 then
        return
    end

    if not Tool or Tool.Parent ~= Character then
        return
    end

    if not SetupTool(Tool) then
        return
    end

    if not AnimationTrack and not LoadAnimation() then
        return
    end

    Busy = true
    LastAttack = os.clock()

    -- เริ่มตรวจจับเฉพาะตอนกด Q
    StartHitDetection()

    AnimationTrack:Play()

    local CurrentTrack = AnimationTrack

    task.spawn(function()
        CurrentTrack.Stopped:Wait()

        if AnimationTrack == CurrentTrack then
            FinishAttack()
        end
    end)
end)

--==================================================
-- เชื่อมต่อ Tool เพียงครั้งเดียว
--==================================================

local function BindTool(ToolObject)
    if not ToolObject:IsA("Tool") then
        return
    end

    if BoundTools[ToolObject] then
        return
    end

    BoundTools[ToolObject] = true

    ToolObject.Equipped:Connect(function()
        if not Character or ToolObject.Parent ~= Character then
            return
        end

        Tool = ToolObject
        Equipped = true

        if not LoadAnimation() then
            Equipped = false
        end
    end)

    ToolObject.Unequipped:Connect(function()
        if Tool ~= ToolObject then
            return
        end

        Equipped = false
        FinishAttack()

        if AnimationTrack then
            AnimationTrack:Stop()
        end
    end)

    ToolObject.Destroying:Connect(function()
        BoundTools[ToolObject] = nil

        if Tool == ToolObject then
            FinishAttack()

            Tool = nil
            DamageEvent = nil
            Animation = nil
            HitBox = nil
            HitSound = nil
            Equipped = false
        end
    end)
end

--==================================================
-- ตั้งค่าตัวละคร
--==================================================

local function OnCharacterAdded(NewCharacter)
    StopHitDetection()

    if CharacterChildConnection then
        CharacterChildConnection:Disconnect()
        CharacterChildConnection = nil
    end

    if AnimationTrack then
        AnimationTrack:Stop()
        AnimationTrack:Destroy()
        AnimationTrack = nil
    end

    Character = NewCharacter
    Humanoid = NewCharacter:WaitForChild("Humanoid")

    Animator = nil
    Tool = nil
    DamageEvent = nil
    Animation = nil
    HitBox = nil
    HitSound = nil

    Equipped = false
    Busy = false
    AttackHit = false
    LastAttack = 0

    for _, Object in ipairs(NewCharacter:GetChildren()) do
        if Object:IsA("Tool") then
            BindTool(Object)
        end
    end

    CharacterChildConnection =
        NewCharacter.ChildAdded:Connect(function(Object)
            if Object:IsA("Tool") then
                BindTool(Object)
            end
        end)

    Humanoid.Died:Connect(function()
        Equipped = false
        FinishAttack()
    end)
end

--==================================================
-- ตรวจจับ Tool ใน Backpack
--==================================================

local Backpack = SetupTool()

for _, Object in ipairs(Backpack:GetChildren()) do
    if Object:IsA("Tool") then
        BindTool(Object)
    end
end

Backpack.ChildAdded:Connect(function(Object)
    if Object:IsA("Tool") then
        BindTool(Object)
    end
end)

Player.CharacterAdded:Connect(OnCharacterAdded)

if Player.Character then
    task.spawn(OnCharacterAdded, Player.Character)
end
