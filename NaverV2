Player.CharacterAdded:Connect(OnCharacterAdded)
local function Attack()
    if Busy or not Equipped then
        return
    end

    if os.clock() - LastAttack < COOLDOWN then
        return
    end

    if not Character or not Humanoid or Humanoid.Health <= 0 then
        return
    end

    if not Tool or Tool.Parent ~= Character then
        return
    end

    if not SetupTool(Tool) then
        return
    end

    Busy = true
    LastAttack = os.clock()

    AttackId += 1
    local ThisAttack = AttackId

    StopHitDetection()

    local Candidates = {}

    AttackActive = true

    HitConnection = HitBox.Touched:Connect(function(Part)
        if not AttackActive or ThisAttack ~= AttackId then
            return
        end

        if not Part or Part:IsDescendantOf(Character) then
            return
        end

        if Part:IsDescendantOf(Tool) then
            return
        end

        local TargetPlayer, TargetModel, TargetHumanoid, Distance =
            GetValidTargetFromPart(Part)

        if not TargetPlayer then
            return
        end

        local Existing = Candidates[TargetModel]

        if not Existing or Distance < Existing.Distance then
            Candidates[TargetModel] = {
                Player = TargetPlayer,
                Model = TargetModel,
                Humanoid = TargetHumanoid,
                Distance = Distance
            }
        end
    end)

    if AnimationTrack then
        AnimationTrack:Play()
    end

    task.wait(HIT_SCAN_TIME)

    if ThisAttack ~= AttackId or not AttackActive then
        StopHitDetection()
        Busy = false
        return
    end

    StopHitDetection()

    -- เลือกคนใกล้ที่สุดจากผู้เล่นที่โดน HitBox จริงเท่านั้น
    local BestTarget = nil
    local BestDistance = MAX_DISTANCE

    for Model, Data in pairs(Candidates) do
        -- ตรวจซ้ำก่อนส่งคำขอทำดาเมจ
        local TargetHumanoid = Model:FindFirstChildOfClass("Humanoid")
        local TargetRoot = Model:FindFirstChild("HumanoidRootPart")
        local MyRoot = Character and Character:FindFirstChild("HumanoidRootPart")

        if TargetHumanoid
            and TargetHumanoid.Health > 0
            and TargetRoot
            and MyRoot
            and Players:GetPlayerFromCharacter(Model) == Data.Player then

            local CurrentDistance =
                (MyRoot.Position - TargetRoot.Position).Magnitude

            if CurrentDistance <= MAX_DISTANCE
                and CurrentDistance < BestDistance then

                BestDistance = CurrentDistance
                BestTarget = Model
            end
        end
    end

    -- ส่งเป้าหมายเพียงคนเดียว
    if BestTarget
        and DamageEvent
        and DamageEvent.Parent then

        local TargetHumanoid =
            BestTarget:FindFirstChildOfClass("Humanoid")

        if TargetHumanoid and TargetHumanoid.Health > 0 then
            DamageEvent:FireServer(BestTarget, "Head")

            if HitSound and HitSound:IsA("Sound") then
                HitSound:Stop()
                HitSound.TimePosition = 0
                HitSound:Play()
            end
        end
    end

    -- ปลดล็อกโดยไม่รอ Animation จบแบบไม่มีเงื่อนไข
    if AnimationTrack then
        AnimationTrack.Stopped:Wait()
    end

    if ThisAttack == AttackId then
        StopHitDetection()
        Busy = false
    end
end
