local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local Player = Players.LocalPlayer

-- CONFIG
local MAX_DISTANCE = 6.5
local COOLDOWN = 0.5
local KEYBIND = Enum.KeyCode.Q
local HIT_SCAN_TIME = 0.15
-- STATE
local Character
local Humanoid
local Animator
local AnimationTrack


local AttackId = nil

local Tool
local DamageEvent
local Animation
local HitBox
local HitSound

local Equipped = false
local Busy = false
local AttackActive = false
local AttackHit = false
local LastAttack = 0
local AttackId = 0
local HitConnection
local BoundTools = {}
local CharacterChildConnection
local function SetupCharacter(NewCharacter)
    Character = NewCharacter
    Humanoid = NewCharacter:WaitForChild("Humanoid")
    Animator = Humanoid:WaitForChild("Animator")

    Equipped = false
    Busy = false
    AttackActive = false

    if HitConnection then
        HitConnection:Disconnect()
        HitConnection = nil
    end

    if AnimationTrack then
        AnimationTrack:Stop()
        AnimationTrack:Destroy()
        AnimationTrack = nil
    end
end

Player.CharacterAdded:Connect(SetupCharacter)

if Player.Character then
    task.spawn(SetupCharacter, Player.Character)
end

--==================================================
-- VALIDATE TARGET
--==================================================

local function GetValidTargetFromPart(Part)
    if not Part or not Part:IsA("BasePart") then
        return nil
    end

    local Model = Part:FindFirstAncestorOfClass("Model")
    if not Model or Model == Character then
        return nil
    end

    local TargetPlayer = Players:GetPlayerFromCharacter(Model)
    if not TargetPlayer or TargetPlayer == Player then
        return nil
    end

    local TargetHumanoid = Model:FindFirstChildOfClass("Humanoid")
    local TargetRoot = Model:FindFirstChild("HumanoidRootPart")
    local MyRoot = Character and Character:FindFirstChild("HumanoidRootPart")

    -- ต้องมีชีวิตอยู่จริง
    if not TargetHumanoid or TargetHumanoid.Health <= 0 then
        return nil
    end

    if not TargetRoot or not MyRoot then
        return nil
    end

    -- ต้องอยู่ในระยะที่กำหนด
    local Distance = (MyRoot.Position - TargetRoot.Position).Magnitude
    if Distance > MAX_DISTANCE then
        return nil
    end

    return TargetPlayer, Model, TargetHumanoid, Distance
end
-- หา Tool และ RemoteEvent
local function SetupTool(CurrentTool)
    if not CurrentTool or not CurrentTool:IsA("Tool") then
        return false
    end

    local Handle = CurrentTool:FindFirstChild("Handle")
    if not Handle then
        warn("Q Slash: ไม่พบ Handle")
        return false
    end

    local CurrentHitBox = Handle:FindFirstChild("HitBox")
    local CurrentHitSound = Handle:FindFirstChild("Hit")

    if not CurrentHitBox or not CurrentHitBox:IsA("BasePart") then
        warn("Q Slash: ไม่พบ Handle.HitBox")
        return false
    end

    if not CurrentHitSound or not CurrentHitSound:IsA("Sound") then
        warn("Q Slash: ไม่พบ Handle.Hit")
        return false
    end

    -- หา RemoteEvent
    local CurrentEvent = CurrentTool:FindFirstChild("Damage", true)

    if not CurrentEvent then
        local LocalScriptObject =
            CurrentTool:FindFirstChild("LocalScript")

        CurrentEvent = LocalScriptObject
            and LocalScriptObject:FindFirstChild("Damage")
    end

    if not CurrentEvent or not CurrentEvent:IsA("RemoteEvent") then
        warn("Q Slash: ไม่พบ RemoteEvent Damage")
        return false
    end

    -- หา Animation
    local CurrentAnimation =
        CurrentTool:FindFirstChild("RightSlashx", true)

    if not CurrentAnimation
        or not CurrentAnimation:IsA("Animation") then
        warn("Q Slash: ไม่พบ Animation RightSlashx")
        return false
    end

    Tool = CurrentTool
    DamageEvent = CurrentEvent
    Animation = CurrentAnimation
    HitBox = CurrentHitBox
    HitSound = CurrentHitSound

    return true
end

--==================================================
-- โหลด Animation
--==================================================

local function LoadAnimation()
    if not Character or not Humanoid or Humanoid.Health <= 0 then
        return false
    end

    if not SetupTool(Tool) then
        return false
    end

    Animator = Humanoid:FindFirstChildOfClass("Animator")

    if not Animator then
        Animator = Instance.new("Animator")
        Animator.Parent = Humanoid
    end

    if AnimationTrack then
        AnimationTrack:Stop()
        AnimationTrack:Destroy()
        AnimationTrack = nil
    end

    local Success, Result = pcall(function()
        return Animator:LoadAnimation(Animation)
    end)

    if not Success then
        warn("Q Slash: โหลด Animation ไม่สำเร็จ:", Result)
        return false
    end

    AnimationTrack = Result
    return true
end

--==================================================
-- หาผู้เล่นที่ HitBox สัมผัสจริง
--==================================================

local function GetTouchedPlayer(Part)
    if not Part or not Part:IsA("BasePart") then
        return nil, nil, nil
    end

    if not Character or Part:IsDescendantOf(Character) then
        return nil, nil, nil
    end

    if Tool and Part:IsDescendantOf(Tool) then
        return nil, nil, nil
    end

    -- รองรับ Part ที่อยู่ใน Accessory ของตัวละคร
    local Current = Part
    local TargetPlayer
    local TargetModel

    while Current and Current ~= workspace do
        if Current:IsA("Model") then
            local FoundPlayer = Players:GetPlayerFromCharacter(Current)

            if FoundPlayer then
                TargetPlayer = FoundPlayer
                TargetModel = Current
                break
            end
        end

        Current = Current.Parent
    end

    if not TargetPlayer or not TargetModel then
        return nil, nil, nil
    end

    if TargetPlayer == Player then
        return nil, nil, nil
    end

    local TargetHumanoid =
        TargetModel:FindFirstChildOfClass("Humanoid")

    local TargetRoot =
        TargetModel:FindFirstChild("HumanoidRootPart")

    local MyRoot =
        Character:FindFirstChild("HumanoidRootPart")

    -- ต้องยังมีชีวิตอยู่
    if not TargetHumanoid
        or TargetHumanoid.Health <= 0
        or not TargetRoot
        or not MyRoot then
        return nil, nil, nil
    end

    local Distance =
        (MyRoot.Position - TargetRoot.Position).Magnitude

    if Distance > MAX_DISTANCE then
        return nil, nil, nil
    end

    return TargetPlayer, TargetModel, TargetHumanoid
end

--==================================================
-- หยุดตรวจจับ HitBox
--==================================================

local function StopHitDetection()
    AttackActive = false

    if HitConnection then
        HitConnection:Disconnect()
        HitConnection = nil
    end
end

--==================================================
-- เริ่มตรวจจับ HitBox
--==================================================

local function StartHitDetection()
    StopHitDetection()

    if not HitBox or not HitBox:IsA("BasePart") then
        return
    end

    if not HitBox.CanTouch then
        warn("Q Slash: กรุณาเปิด HitBox.CanTouch")
        return
    end

    AttackActive = true
    AttackHit = false

    HitConnection = HitBox.Touched:Connect(function(Part)
        if not AttackActive or AttackHit then
            return
        end

        local TargetPlayer, TargetModel, TargetHumanoid =
            GetTouchedPlayer(Part)

        if not TargetPlayer or not TargetModel or not TargetHumanoid then
            return
        end

        -- ตรวจเลือดซ้ำก่อนเลือกเป้าหมาย
        if TargetHumanoid.Health <= 0 then
            return
        end

        -- เลือกคนแรกที่ HitBox สัมผัสในรอบนี้
        AttackHit = true
        AttackActive = false

        if HitConnection then
            HitConnection:Disconnect()
            HitConnection = nil
        end

        -- เล่นเสียงเมื่อสัมผัสเป้าหมาย
        if HitSound then
            HitSound:Stop()
            HitSound.TimePosition = 0
            HitSound:Play()
        end

        -- ตรวจสอบเป้าหมายอีกครั้ง
        if TargetPlayer.Parent ~= Players
            or not TargetModel.Parent
            or TargetHumanoid.Health <= 0 then
            return
        end

        if not DamageEvent
            or not DamageEvent:IsA("RemoteEvent") then
            warn("Q Slash: DamageEvent ไม่พร้อมใช้งาน")
            return
        end

        DamageEvent:FireServer(TargetModel, "Head")
    end)
end

--==================================================
-- จบการโจมตี
--==================================================

local function FinishAttack()
    StopHitDetection()
    Busy = false
end

