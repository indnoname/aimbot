getgenv().Players = game:GetService("Players")
getgenv().UserInputService = game:GetService("UserInputService")
getgenv().RunService = game:GetService("RunService")

getgenv().LocalPlayer = getgenv().Players.LocalPlayer

-- SETTINGS
getgenv().AimPart = "HumanoidRootPart"
getgenv().AimRadius = 20
getgenv().MaxDistance = 120
getgenv().TeamCheck = false

-- STATE
getgenv().AimlockEnabled = true
getgenv().Locked = false
getgenv().HoldingRightClick = false
getgenv().TargetCharacter = nil
getgenv().TargetHumanoid = nil

getgenv().DeadCharacters = setmetatable({}, {
	__mode = "k"
})

--==================================================
-- TARGET VALIDATION
--==================================================

getgenv().GetCharacterParts = function(Character)
	if not Character or not Character:IsA("Model") then
		return nil, nil
	end

	local Humanoid = Character:FindFirstChildOfClass("Humanoid")
	local AimPartInstance = Character:FindFirstChild(
		getgenv().AimPart
	)

	if not Humanoid or not AimPartInstance then
		return nil, nil
	end

	if Humanoid.Health <= 0 then
		return nil, nil
	end

	return Humanoid, AimPartInstance
end

--==================================================
-- TEAM CHECK
--==================================================

getgenv().IsSameTeam = function(Character)
	if not getgenv().TeamCheck then
		return false
	end

	local TargetPlayer =
		getgenv().Players:GetPlayerFromCharacter(Character)

	return TargetPlayer ~= nil
		and getgenv().LocalPlayer.Team ~= nil
		and TargetPlayer.Team ~= nil
		and getgenv().LocalPlayer.Team == TargetPlayer.Team
end

--==================================================
-- LINE OF SIGHT
--==================================================

getgenv().HasLineOfSight = function(Character, AimPartInstance)
	local Camera = workspace.CurrentCamera

	if not Camera then
		return false
	end

	local Origin = Camera.CFrame.Position
	local Direction = AimPartInstance.Position - Origin

	local Params = RaycastParams.new()
	Params.FilterType = Enum.RaycastFilterType.Exclude
	Params.FilterDescendantsInstances = {
		getgenv().LocalPlayer.Character
	}

	local Result = workspace:Raycast(
		Origin,
		Direction,
		Params
	)

	return Result ~= nil
		and Result.Instance:IsDescendantOf(Character)
end

--==================================================
-- FIND TARGET
--==================================================

getgenv().GetNearestTarget = function()
	local Camera = workspace.CurrentCamera

	if not Camera then
		return nil
	end

	local MousePosition =
		getgenv().UserInputService:GetMouseLocation()

	local ClosestCharacter = nil
	local ClosestDistance = getgenv().AimRadius
	local CheckedCharacters = {}

	for _, Player in ipairs(getgenv().Players:GetPlayers()) do
		if Player ~= getgenv().LocalPlayer and Player.Character then
			table.insert(CheckedCharacters, Player.Character)
		end
	end

	for _, Object in ipairs(workspace:GetDescendants()) do
		if Object:IsA("Humanoid") then
			local Character = Object.Parent

			if Character
				and Character:IsA("Model")
				and not table.find(CheckedCharacters, Character) then

				table.insert(CheckedCharacters, Character)
			end
		end
	end

	local MyCharacter = getgenv().LocalPlayer.Character
	local MyRoot = MyCharacter
		and MyCharacter:FindFirstChild("HumanoidRootPart")

	if not MyRoot then
		return nil
	end

	for _, Character in ipairs(CheckedCharacters) do
		if Character ~= MyCharacter
			and not getgenv().DeadCharacters[Character]
			and not getgenv().IsSameTeam(Character) then

			local Humanoid, AimPartInstance =
				getgenv().GetCharacterParts(Character)

			if Humanoid and AimPartInstance then
				local WorldDistance =
					(MyRoot.Position - AimPartInstance.Position).Magnitude

				if WorldDistance <= getgenv().MaxDistance
					and getgenv().HasLineOfSight(
						Character,
						AimPartInstance
					) then

					local ScreenPosition, Visible =
						Camera:WorldToViewportPoint(
							AimPartInstance.Position
						)

					if Visible then
						local ScreenDistance = (
							MousePosition
							- Vector2.new(
								ScreenPosition.X,
								ScreenPosition.Y
							)
						).Magnitude

						if ScreenDistance < ClosestDistance then
							ClosestDistance = ScreenDistance
							ClosestCharacter = Character
						end
					end
				end
			end
		end
	end

	return ClosestCharacter
end

--==================================================
-- UNLOCK
--==================================================

getgenv().UnlockTarget = function()
	getgenv().Locked = false
	getgenv().TargetCharacter = nil
	getgenv().TargetHumanoid = nil
end

--==================================================
-- LOCK
--==================================================

getgenv().LockTarget = function(Character)
	if not Character
		or getgenv().DeadCharacters[Character] then
		return
	end

	local Humanoid = getgenv().GetCharacterParts(Character)

	if not Humanoid then
		return
	end

	getgenv().TargetCharacter = Character
	getgenv().TargetHumanoid = Humanoid
	getgenv().Locked = true

	Humanoid.Died:Once(function()
		getgenv().DeadCharacters[Character] = true

		if getgenv().TargetCharacter == Character then
			getgenv().UnlockTarget()
		end
	end)
end

--==================================================
-- INPUT
--==================================================

getgenv().UserInputService.InputBegan:Connect(
	function(Input, Processed)
		if Processed then
			return
		end

		local CtrlHeld =
			getgenv().UserInputService:IsKeyDown(
				Enum.KeyCode.LeftControl
			)
			or getgenv().UserInputService:IsKeyDown(
				Enum.KeyCode.RightControl
			)

		if CtrlHeld and Input.KeyCode == Enum.KeyCode.P then
			getgenv().AimlockEnabled =
				not getgenv().AimlockEnabled

			if not getgenv().AimlockEnabled then
				getgenv().UnlockTarget()
				getgenv().HoldingRightClick = false
			end

			return
		end

		if not getgenv().AimlockEnabled then
			return
		end

		if Input.UserInputType == Enum.UserInputType.MouseButton2 then
			getgenv().HoldingRightClick = true

			local AltHeld =
				getgenv().UserInputService:IsKeyDown(
					Enum.KeyCode.LeftAlt
				)
				or getgenv().UserInputService:IsKeyDown(
					Enum.KeyCode.RightAlt
				)

			if AltHeld or not getgenv().Locked then
				local NewTarget = getgenv().GetNearestTarget()

				if NewTarget then
					getgenv().LockTarget(NewTarget)
				elseif AltHeld then
					getgenv().UnlockTarget()
				end
			end
		end

		if Input.KeyCode == Enum.KeyCode.RightShift then
			getgenv().UnlockTarget()
		end
	end
)

getgenv().UserInputService.InputEnded:Connect(function(Input)
	if Input.UserInputType == Enum.UserInputType.MouseButton2 then
		getgenv().HoldingRightClick = false
	end
end)

--==================================================
-- CAMERA TRACKING
--==================================================

getgenv().RunService:BindToRenderStep(
	"AimlockCamera",
	Enum.RenderPriority.Camera.Value + 1,
	function()
		if not getgenv().AimlockEnabled
			or not getgenv().Locked
			or not getgenv().HoldingRightClick then
			return
		end

		local Camera = workspace.CurrentCamera

		if not Camera then
			return
		end

		local Character = getgenv().TargetCharacter
		local TargetHumanoid = getgenv().TargetHumanoid

		if not Character or not TargetHumanoid then
			getgenv().UnlockTarget()
			return
		end

		local Humanoid, AimPartInstance =
			getgenv().GetCharacterParts(Character)

		if not Humanoid
			or Humanoid ~= TargetHumanoid
			or Humanoid.Health <= 0 then

			getgenv().UnlockTarget()
			return
		end

		local MyCharacter = getgenv().LocalPlayer.Character
		local MyRoot = MyCharacter
			and MyCharacter:FindFirstChild("HumanoidRootPart")

		if not MyRoot then
			return
		end

		local Distance =
			(MyRoot.Position - AimPartInstance.Position).Magnitude

		if Distance > getgenv().MaxDistance then
			return
		end

		if not getgenv().HasLineOfSight(
			Character,
			AimPartInstance
			) then
			return
		end

		Camera.CFrame = CFrame.lookAt(
			Camera.CFrame.Position,
			AimPartInstance.Position
		)
	end
)

--==================================================
-- CLEANUP
--==================================================

getgenv().CleanupAimlock = function()
	getgenv().RunService:UnbindFromRenderStep("AimlockCamera")
	getgenv().UnlockTarget()
end

