    if not getgenv().Aimlock then
        return
    end
    if not getgenv().Holding then
        return
    end
    if not getgenv().Camera then
        return
    end
    if getgenv().AutoSwitchTarget then
        local NewTarget =
            getgenv().GetNearestTarget()
        if NewTarget then
            getgenv().AimlockTarget =
                NewTarget
        end
    end
        getgenv().AimlockTarget
    if not Target then
        return
    end
    local Character =
        Target.Character
    if not Character then
        getgenv().AimlockTarget = nil
        return
    end
    local Humanoid =
        Character:FindFirstChild(
            "Humanoid"
        )
    if not Humanoid
    or Humanoid.Health <= 0 then
        getgenv().AimlockTarget = nil
        return
    end
    if not Character:FindFirstChild(
        getgenv().AimPart
    ) then
        getgenv().AimlockTarget = nil
        return
    end
    local AimPart =
        Character[getgenv().AimPart]
    -- OFFSCREEN CHECK
    local ScreenPos, Visible =
        getgenv().Camera:WorldToViewportPoint(
            AimPart.Position
        )
    if not Visible then
        getgenv().AimlockTarget = nil
        return
    end
    -- WALL CHECK
    if not getgenv().WallCheck(
        Character
    ) then
        getgenv().AimlockTarget = nil
        return
    end
if getgenv().LocalPlayer.Character
and getgenv().LocalPlayer.Character:FindFirstChild(
    "HumanoidRootPart"
) then

    local Distance =
        (
            getgenv().LocalPlayer.Character.HumanoidRootPart.Position
            - AimPart.Position
        ).Magnitude

    if Distance > getgenv().SwitchDistance then

        local NewTarget =
            getgenv().GetNearestTarget()

        if NewTarget then
            getgenv().AimlockTarget =
                NewTarget
        else
            getgenv().AimlockTarget = nil
        end

        return
    end
