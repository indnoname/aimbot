-- ตรวจจับการถือและเก็บ Tool
local function BindTool(ToolObject)
    if not ToolObject:IsA("Tool") then
        return
    end

    ToolObject.Equipped:Connect(function()
        if ToolObject.Parent ~= Character then
            return
        end

        Tool = ToolObject
        Equipped = true
        LoadAnimation()
    end)

    ToolObject.Unequipped:Connect(function()
        if Tool ~= ToolObject then
            return
        end

        Equipped = false
        Busy = false

        if AnimationTrack then
            AnimationTrack:Stop()
        end
    end)
end

local function WatchCharacter(NewCharacter)
    for _, Object in ipairs(NewCharacter:GetChildren()) do
        if Object:IsA("Tool") then
            BindTool(Object)
        end
    end

    NewCharacter.ChildAdded:Connect(function(Object)
        if Object:IsA("Tool") then
            BindTool(Object)
        end
    end)
end

Player.CharacterAdded:Connect(WatchCharacter)

if Player.Character then
    WatchCharacter(Player.Character)
end

