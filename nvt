local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")

local Player = Players.LocalPlayer

-- CONFIG
local MAX_DISTANCE = 4
local COOLDOWN = 0.5
local KEYBIND = Enum.KeyCode.Q

-- STATE
local Character
local Humanoid
local Animator
local AnimationTrack

local Equipped = false
local Busy = false
local LastAttack = 0

-- TOOL REFERENCES
local Tool
local Event
local Animation

-- หา Tool และ RemoteEvent
local function SetupTool()
    local CurrentCharacter = Player.Character
    if not CurrentCharacter then
        return false
    end

    Tool = CurrentCharacter:FindFirstChildOfClass("Tool")

    if not Tool then
        return false
    end

    local LocalScript = Tool:FindFirstChild("LocalScript")
    local Event = LocalScript and LocalScript:FindFirstChild("Damage")
    Animation = Tool:FindFirstChild("RightSlashx", true)

    if not Event or not Event:IsA("RemoteEvent") then
        warn("ไม่พบ RemoteEvent: Damage")
        return false
    end

    if not Animation or not Animation:IsA("Animation") then
        warn("ไม่พบ Animation: RightSlashx")
        return false
    end

    return true
end

-- โหลดอนิเมชัน
local function LoadAnimation()
    if not Character or not Humanoid or Humanoid.Health <= 0 then
        return false
    end

    if not SetupTool() then
        return false
    end

    Animator = Humanoid:FindFirstChildOfClass("Animator")

    if not Animator then
        Animator = Instance.new("Animator")
        Animator.Parent = Humanoid
    end

    if AnimationTrack then
        AnimationTrack:Stop()
        AnimationTrack:Destroy()
        AnimationTrack = nil
    end

    local Success, Result = pcall(function()
        return Animator:LoadAnimation(Animation)
    end)

    if not Success then
        warn("โหลดอนิเมชันไม่สำเร็จ:", Result)
        return false
    end

    AnimationTrack = Result
    return true
end

